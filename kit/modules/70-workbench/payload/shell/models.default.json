{
  "version": 1,
  "_comment": [
    "Kit model registry source. port/regenerate.py (step 'registry') builds payload/shell/models.default.json from it:",
    "harness adapters come from the live registry (only the ids in keepHarnesses, then harnessOverrides field by field, then addHarnesses);",
    "providers and models come from this file only. Nothing of the build machine's own models ships.",
    "Local models: the 15-local-llm catalog (kit/modules/15-local-llm/models.conf), served by kit-llm (llama.cpp) as provider kit-llm.",
    "The endpoint is the provider's baseUrl; the environment variable in baseUrlEnv (KIT_LLM_BASE_URL) overrides it.",
    "Cloud models: one or a few public ids per harness of 16-harness-clis. 'wb-state models discover' imports what the installed CLIs,",
    "pi's ~/.pi/agent/models.json and kit-llm's catalog actually offer."
  ],
  "providers": [
    {
      "id": "claude-subscription",
      "label": "Claude Code (sign-in)",
      "kind": "subscription",
      "notes": "No API key: Claude Code signs in itself."
    },
    {
      "id": "chatgpt",
      "label": "OpenAI Codex (ChatGPT sign-in)",
      "kind": "subscription",
      "apiKeyEnv": null,
      "keychainService": null
    },
    {
      "id": "google-gemini",
      "label": "Gemini CLI (Google sign-in)",
      "kind": "subscription",
      "apiKeyEnv": null,
      "keychainService": null
    },
    {
      "id": "github-copilot",
      "label": "GitHub Copilot (GitHub sign-in)",
      "kind": "subscription",
      "apiKeyEnv": null,
      "keychainService": null
    },
    {
      "id": "opencode-zen",
      "label": "opencode (its own sign-in)",
      "kind": "subscription",
      "apiKeyEnv": null,
      "keychainService": null
    },
    {
      "id": "kit-llm",
      "label": "kit-llm (llama.cpp, local)",
      "kind": "local",
      "baseUrl": "http://127.0.0.1:8080/v1",
      "baseUrlEnv": "KIT_LLM_BASE_URL",
      "defaultRunner": "pi",
      "discover": {
        "source": "kit-llm",
        "runners": [
          "pi",
          "aider"
        ],
        "supportsEffort": true,
        "refTemplateByRunner": {
          "aider": "openai/{name}"
        },
        "notes": "The catalog of 15-local-llm: 'kit-llm models', else models.conf of the installed kit."
      },
      "notes": "OpenAI-compatible endpoint of 15-local-llm ('kit-llm start <model>'). KIT_LLM_BASE_URL overrides baseUrl, e.g. for a server on another host."
    },
    {
      "id": "ollama",
      "label": "Ollama (local)",
      "kind": "local",
      "baseUrl": "http://127.0.0.1:11434",
      "notes": "Only when Ollama is installed; no Ollama model ships."
    }
  ],
  "harnesses": [
    {
      "id": "claude",
      "label": "Claude Code",
      "orchestratorDefaultModel": "opus",
      "builtin": true,
      "command": "~/.local/bin/claude",
      "modelFamilyAliases": [
        {
          "aliases": [
            "opus",
            "claude-opus"
          ],
          "idPattern": "^claude-opus-(?P<version>[0-9]+(?:-[0-9]+)*)$"
        },
        {
          "aliases": [
            "sonnet",
            "claude-sonnet"
          ],
          "idPattern": "^claude-sonnet-(?P<version>[0-9]+(?:-[0-9]+)*)$"
        },
        {
          "aliases": [
            "haiku",
            "claude-haiku"
          ],
          "idPattern": "^claude-haiku-(?P<version>[0-9]+(?:-[0-9]+)*)$"
        },
        {
          "aliases": [
            "fable",
            "claude-fable"
          ],
          "idPattern": "^claude-fable-(?P<version>[0-9]+(?:-[0-9]+)*)$"
        }
      ],
      "discover": {
        "source": "binary-strings",
        "pattern": "(?P<id>claude-(?P<family>opus|sonnet|haiku|fable)-(?P<version>[0-9]+(?:-[0-9]+)*)(?:\\[1m\\])?)",
        "labelPattern": "{familyTitle} {versionDots} - ",
        "variantLabelPattern": "{familyTitle} {versionDots} with 1M context",
        "idPrefix": "",
        "provider": "claude-subscription",
        "contextWindowBySuffix": {
          "[1m]": 1000000
        },
        "notes": "Reads the model list the installed CLI keeps itself."
      },
      "args": [
        "--model",
        "{model}"
      ],
      "cwdMode": "cd",
      "effort": {
        "style": "arg",
        "args": [
          "--effort",
          "{effort}"
        ],
        "map": {
          "low": "low",
          "medium": "medium",
          "high": "high",
          "xhigh": "xhigh",
          "max": "max"
        }
      },
      "systemPrompt": {
        "style": "flag-content",
        "flag": "--append-system-prompt",
        "worker": "~/.claude/roles/agent.md",
        "orchestrator": "~/.claude/roles/orchestrator.md"
      },
      "autonomy": {
        "args": [
          "--dangerously-skip-permissions"
        ]
      },
      "resume": {
        "args": [
          "--resume",
          "{resumeId}"
        ],
        "fallbackArgs": [
          "--continue"
        ],
        "probe": "revive-only"
      },
      "modelSwitch": {
        "command": "/model {model}",
        "updateRequiredPattern": "(?i)update required|aktualisierung erforderlich",
        "versionGate": true,
        "notes": "Gemessen mit Claude Code: der Slash-Befehl wechselt in einer laufenden Sitzung; kennt die laufende Version das Modell noch nicht, meldet sie update required. Dann wird derselbe Pane ueber den vorhandenen Resume-Vertrag neu gestartet."
      },
      "readyPattern": "❯|░|●",
      "promptPattern": "^❯",
      "compactCommand": "/compact",
      "contextPattern": null,
      "session": {
        "via": "sessionFile",
        "ort": "~/.claude/projects/{cwdSlug}/{sessionId}.jsonl",
        "format": "claude-transcript",
        "maxAgeSec": null,
        "zuordnung": "hook",
        "live": true,
        "eingabe": "pane",
        "zeigtNicht": [
          "freigabedialog",
          "arbeits-anzeige"
        ],
        "hook": {
          "style": "claude-settings-json",
          "file": "~/.claude/settings.json",
          "event": "SessionStart",
          "matcher": "startup|resume|clear|compact",
          "timeout": 30
        },
        "probe": {
          "datum": "2026-08-11",
          "beleg": "Measured upstream on macOS. If a spawn on this machine does not see the input line, re-measure with: wb-harness-probe <harness>."
        }
      },
      "instructionFiles": [
        "~/.claude/AGENTS.md",
        "<project>/AGENTS.md"
      ],
      "supportsPaste": true,
      "altScreen": true,
      "probe": "Measured upstream on macOS. If a spawn on this machine does not see the input line, re-measure with: wb-harness-probe <harness>.",
      "notes": "Family aliases resolve to the newest enabled Claude model on every start. contextPattern stays null because context-guard measures Claude panes natively.",
      "promptIgnore": "^❯ Press up to edit queued messages"
    },
