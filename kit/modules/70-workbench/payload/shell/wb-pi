#!/bin/bash
# wb-pi — open an INTERACTIVE local pi agent (chat window) as a workbench pane.
# Usage: wb-pi <provider>/<model> | <registry id>   (e.g. kit-llm/qwen3.5-4b)
# Kit: local models come from 15-local-llm (kit-llm) or any provider of pi's models.json.
set -u
# Kit fix: opens a live pi pane, so the model must be named and the call must come from a
# workbench tmux session (outside tmux, split-window would pick any running session).
if [ $# -eq 0 ] || [ -z "${TMUX:-}" ]; then
  echo "usage: wb-pi <provider>/<model> | <registry id>   (inside a wb-code session; e.g. wb-pi kit-llm/qwen3.5-4b)" >&2
  exit 2
fi
MODEL="$1"
case "$MODEL" in
  */*) ;;
  *)
    RP="$("$HOME/.local/bin/wb-state" models get "$MODEL" --field provider 2>/dev/null || true)"
    RM="$("$HOME/.local/bin/wb-state" models get "$MODEL" --field modelRef 2>/dev/null || true)"
    [ -n "$RP" ] && [ -n "$RM" ] && MODEL="$RP/$RM" ;;
esac
if ! "$HOME/.local/bin/wb-state" models pi-known "$MODEL" >/dev/null 2>&1; then
  echo "wb-pi: unknown model '$MODEL' -- use <provider>/<model> from ~/.pi/agent/models.json or a registry id (wb-state models table)." >&2
  exit 1
fi
PIPROVIDER="${MODEL%%/*}"; MODEL="${MODEL#*/}"
"$HOME/.local/bin/wb-state" models pi-ensure "$PIPROVIDER" "$MODEL" >/dev/null || exit 1

panes=$(tmux list-panes -F '#{pane_id} #{@wb_role}')
target=$(echo "$panes" | awk '$2=="orchestrator"{print $1; exit}')
[ -z "${target:-}" ] && target=$(echo "$panes" | awk '$2!="sidebar"{print $1; exit}')

CMD="KIT_AGENT_ROLE=worker PATH=\$HOME/.local/bin:/opt/homebrew/bin:\$PATH pi --provider '$PIPROVIDER' --model '$MODEL' --append-system-prompt \$HOME/.pi/agent/WORKER.md; echo '── pi beendet — Pane bleibt offen ──'; exec bash"
new=$(tmux split-window -v -t "${target:-}" -P -F '#{pane_id}' -c "#{pane_current_path}" "bash -lc $(printf %q "$CMD")")
tmux set -p -t "$new" @wb_role worker
tmux select-pane -t "$new" -T "pi-chat:$MODEL"
"$HOME/.local/bin/wb-grid"
