#!/usr/bin/env python3
"""Stand-in for llama-server in tests: parses the flags kit-llm passes, answers /health,
/v1/models and /v1/chat/completions. FAKE_LLAMA_FAIL=1 makes it exit at start."""
import http.server, json, os, sys, time

if "--version" in sys.argv:
    print("version: 0 (fake)"); sys.exit(0)
if os.environ.get("FAKE_LLAMA_FAIL"):
    print("error: failed to load model (fake)", file=sys.stderr); sys.exit(1)
args = sys.argv[1:]
opt = lambda k, d=None: args[args.index(k) + 1] if k in args else d
port, alias = int(opt("--port", "8080")), opt("--alias", "fake")
print("fake llama-server args:", " ".join(args), flush=True)
time.sleep(float(os.environ.get("FAKE_LLAMA_DELAY", "0.3")))

class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def _json(self, obj, code=200):
        d = json.dumps(obj).encode()
        self.send_response(code); self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(d))); self.end_headers(); self.wfile.write(d)
    def do_GET(self):
        if self.path == "/health": self._json({"status": "ok"})
        elif self.path == "/v1/models": self._json({"data": [{"id": alias}]})
        else: self._json({"ok": True})
    def do_POST(self):
        body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
        text = body["messages"][-1]["content"]
        self._json({"id": "x", "model": alias, "choices": [{"message": {"role": "assistant", "content": "echo: " + text},
                    "finish_reason": "stop"}], "usage": {"prompt_tokens": 3, "completion_tokens": 2},
                    "timings": {"predicted_per_second": 42.0}})

http.server.HTTPServer(("127.0.0.1", port), H).serve_forever()
