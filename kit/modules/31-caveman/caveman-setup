#!/usr/bin/env python3
"""kit-caveman: make every AI harness answer the human in caveman style (level full).

  caveman-setup install [--dry-run] [--all | --harness LIST] [--project DIR]
  caveman-setup uninstall [--dry-run] [--project DIR]
  caveman-setup verify

Claude Code: SessionStart + UserPromptSubmit hooks in settings.json, the caveman skill and an
always-on block in CLAUDE.md. Codex, Gemini CLI, opencode, Copilot, Cursor, Aider, Continue:
an always-on rule (managed block or file) and, where the harness has skills, the caveman skill.
Standard library only. Existing files are never replaced without a backup
(<file>.bak-<timestamp> below ~/.local/share/work-kit/backups/31-caveman/, same path as below $HOME);
text outside the managed block is never touched.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
UPSTREAM = HERE / "upstream"
HOOK = HERE / "caveman-hook.sh"
RULE_FILE = HERE / "rules" / "caveman-rule.md"

BLOCK_BEGIN = "<!-- work-kit-caveman:begin - managed by 31-caveman, remove with its uninstall.sh -->"
BLOCK_END = "<!-- work-kit-caveman:end -->"
BLOCK_RE = re.compile(r"<!-- work-kit-caveman:begin.*?-->.*?<!-- work-kit-caveman:end -->\n?", re.S)
MANAGED = "<!-- work-kit-caveman:managed - generated by 31-caveman, do not edit -->"
AIDER_MARK = "# work-kit-caveman: chat style"
LEGACY_AIDER_RE = re.compile(re.escape(AIDER_MARK) + r"\nread:\n  - [^\n]*\n?")
HOOK_MARK = "caveman-hook.sh"
SKILL_HARNESSES = {"codex", "gemini", "opencode", "copilot", "cursor"}


class Ctx:
    def __init__(self, home: Path, dry_run: bool):
        self.home = home
        self.dry_run = dry_run
        self.stamp = time.strftime("%Y%m%d%H%M%S")
        self.counts: dict[str, int] = {}
        self.saved_modes: dict[Path, int] = {}
        self.data_dir = Path(os.environ.get("KIT_DATA_DIR") or home / ".local/share/work-kit")

    def say(self, action: str, path, note: str = "") -> None:
        self.counts[action] = self.counts.get(action, 0) + 1
        writes = {"create", "update", "append", "link", "remove", "backup"}
        prefix = "would " if self.dry_run and action in writes else ""
        print(f"[{prefix}{action}] {path}" + (f"  ({note})" if note else ""))

    def backup(self, path: Path) -> None:
        if not (path.exists() or path.is_symlink()):
            return
        dest = self.backup_dest(path)
        self.say("backup", path, f"-> {dest}")
        if not self.dry_run:
            dest.parent.mkdir(parents=True, exist_ok=True)
            if not path.is_symlink():
                self.saved_modes[path] = path.stat().st_mode & 0o777
            shutil.move(str(path), str(dest))

    def backup_dest(self, path: Path) -> Path:
        """Backups live below the kit's data dir, never next to the user's file."""
        path = Path(os.path.abspath(path))
        try:
            rel = path.relative_to(self.home)
        except ValueError:
            rel = Path("_root") / path.relative_to(path.anchor)
        return self.data_dir / "backups" / "31-caveman" / rel.parent / (rel.name + ".bak-" + self.stamp)

    def write(self, path: Path, text: str) -> None:
        if self.dry_run:
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        new = not path.exists()
        path.write_text(text, encoding="utf-8")  # in place: an existing file keeps its mode
        if new:
            path.chmod(self.saved_modes.get(path, 0o644))  # a file moved to the backup gets its mode back


def read(path: Path) -> str:
    return path.read_text(encoding="utf-8")


# --- Aider read: list -------------------------------------------------------------------------
# Kit modules that add a file to the read: list of ~/.aider.conf.yml tag their line with a comment
# "# work-kit-<module> ..."; kit-sync (30-agent-setup) carries such lines when it rebuilds its region.

def read_list_put(text: str, entry: str, mark: str):
    """text with '  - ENTRY  MARK' in the top-level read: list (list created when missing); a line
    with MARK that is already there is updated in place. None when read: is a non-empty inline list."""
    line = "  - %s  %s" % (entry, mark)
    lines = text.splitlines()
    marked = [i for i, ln in enumerate(lines) if mark in ln and ln.lstrip().startswith("-")]
    if marked:
        lines[marked[0]] = line
        for i in reversed(marked[1:]):
            del lines[i]
        return "\n".join(lines) + "\n"
    m = re.search(r"(?m)^read:[ \t]*(.*)$", text)
    if m is None:
        return text + ("" if not text or text.endswith("\n") else "\n") + "read:\n" + line + "\n"
    value = m.group(1).strip()
    if value == "":  # block list: append after its last item
        end = m.end()
        for item in re.finditer(r"\n([ \t]*-[^\n]*)", text[m.end():]):
            if item.start() != end - m.end():
                break
            end = m.end() + item.end()
        return text[:end] + "\n" + line + text[end:]
    if value == "[]":
        return text[:m.start()] + "read:\n" + line + text[m.end():]
    if value.startswith("["):
        return None
    return text[:m.start()] + "read:\n  - %s\n%s" % (value, line) + text[m.end():]  # single value -> block list


def read_list_drop(text: str, mark: str) -> str:
    """text without the lines carrying MARK; a read: key left without items goes with them."""
    lines = [ln for ln in text.splitlines() if not (mark in ln and ln.lstrip().startswith("-"))]
    if len(lines) == len(text.splitlines()):
        return text
    out = []
    for i, ln in enumerate(lines):
        if re.match(r"^read:[ \t]*$", ln) and not (i + 1 < len(lines) and re.match(r"^[ \t]*-", lines[i + 1])):
            continue
        out.append(ln)
    return "\n".join(out) + ("\n" if out else "")


def rule_text() -> str:
    return read(RULE_FILE).strip()


# --- integrity --------------------------------------------------------------------------

def verify_upstream() -> None:
    sums = UPSTREAM / "SHA256SUMS"
    if not sums.is_file():
        sys.exit(f"caveman-setup: missing {sums}")
    bad = []
    for line in read(sums).splitlines():
        if not line.strip():
            continue
        digest, name = line.split(None, 1)
        f = UPSTREAM / name.strip()
        if not f.is_file() or hashlib.sha256(f.read_bytes()).hexdigest() != digest:
            bad.append(name.strip())
    if bad:
        sys.exit("caveman-setup: upstream copy does not match SHA256SUMS: " + ", ".join(bad))


# --- primitives -------------------------------------------------------------------------

def write_block(ctx: Ctx, path: Path, content: str) -> None:
    block = f"{BLOCK_BEGIN}\n{content.strip()}\n{BLOCK_END}\n"
    if not path.exists():
        ctx.write(path, block)
        ctx.say("create", path)
        return
    old = read(path)
    if BLOCK_RE.search(old):
        new = BLOCK_RE.sub(lambda _m: block, old, count=1)
        if new == old:
            ctx.say("unchanged", path)
            return
        ctx.backup(path)
        ctx.write(path, new)
        ctx.say("update", path)
        return
    ctx.backup(path)
    prefix = old.rstrip("\n") + "\n\n" if old.strip() else ""
    ctx.write(path, prefix + block)
    ctx.say("append", path, "managed block added below your text")


def strip_block(ctx: Ctx, path: Path) -> None:
    if not path.exists():
        return
    old = read(path)
    if not BLOCK_RE.search(old):
        return
    new = BLOCK_RE.sub("", old).rstrip("\n")
    if new.strip():
        ctx.backup(path)
        ctx.write(path, new + "\n")
        ctx.say("remove", path, "managed block removed")
    else:
        ctx.say("remove", path, "file held only the managed block")
        if not ctx.dry_run:
            path.unlink()


def write_managed_file(ctx: Ctx, path: Path, body: str, frontmatter: str = "") -> None:
    text = frontmatter + MANAGED + "\n" + body.strip() + "\n"
    if path.exists():
        if read(path) == text:
            ctx.say("unchanged", path)
            return
        if MANAGED not in read(path):
            ctx.backup(path)
        ctx.write(path, text)
        ctx.say("update", path)
        return
    ctx.write(path, text)
    ctx.say("create", path)


def remove_managed_file(ctx: Ctx, path: Path) -> None:
    if path.exists() and MANAGED in read(path):
        ctx.say("remove", path)
        if not ctx.dry_run:
            path.unlink()


def link(ctx: Ctx, dst: Path, target: Path) -> None:
    if dst.is_symlink() and Path(os.readlink(dst)) == target:
        ctx.say("unchanged", dst)
        return
    if dst.exists() or dst.is_symlink():
        ctx.backup(dst)
    if not ctx.dry_run:
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(target)
    ctx.say("link", dst, f"-> {target}")


def unlink_ours(ctx: Ctx, dst: Path) -> None:
    """Remove a skill link only if it points into this module's copy."""
    if dst.is_symlink() and "upstream/skills/caveman" in os.readlink(dst):
        ctx.say("remove", dst)
        if not ctx.dry_run:
            dst.unlink()


def which(binary: str, home: Path):
    dirs = os.environ.get("PATH", "").split(os.pathsep) + [str(home / ".local/bin")]
    for d in dirs:
        p = Path(d) / binary
        if p.is_file() and os.access(p, os.X_OK):
            return p
    return None


# --- harnesses --------------------------------------------------------------------------

class Harness:
    name = ""
    binaries: list[str] = []

    def __init__(self, ctx: Ctx):
        self.ctx = ctx
        self.home = ctx.home

    def config_dirs(self) -> list[Path]:
        return []

    def detected(self) -> bool:
        return any(which(b, self.home) for b in self.binaries) or any(
            d.exists() for d in self.config_dirs())

    def install(self) -> None:
        raise NotImplementedError

    def uninstall(self) -> None:
        raise NotImplementedError


class BlockHarness(Harness):
    def target(self) -> Path:
        raise NotImplementedError

    def install(self) -> None:
        write_block(self.ctx, self.target(), rule_text())

    def uninstall(self) -> None:
        strip_block(self.ctx, self.target())


class Claude(BlockHarness):
    name = "claude"
    binaries = ["claude"]

    def cdir(self) -> Path:
        return Path(os.environ.get("CLAUDE_CONFIG_DIR") or self.home / ".claude")

    def config_dirs(self):
        return [self.cdir()]

    def target(self):
        return self.cdir() / "CLAUDE.md"

    def hook_command(self, arg: str) -> str:
        return f'sh "{HOOK}" {arg}'

    def statusline_command(self) -> str:
        return f'bash "{UPSTREAM / "src/hooks/caveman-statusline.sh"}"'

    def install(self) -> None:
        # Always-on block: the fallback when the hooks are blocked by policy or fail.
        super().install()
        link(self.ctx, self.cdir() / "skills/caveman", UPSTREAM / "skills/caveman")
        self.settings(remove=False)

    def uninstall(self) -> None:
        super().uninstall()
        unlink_ours(self.ctx, self.cdir() / "skills/caveman")
        self.settings(remove=True)
        flag = self.cdir() / ".caveman-active"
        for f in (flag, self.cdir() / ".caveman-active.prev"):
            if f.exists() and not self.ctx.dry_run:
                f.unlink()

    def settings(self, remove: bool) -> None:
        ctx = self.ctx
        path = self.cdir() / "settings.json"
        if not path.exists():
            if remove:
                return
            data: object = {}
        else:
            try:
                data = json.loads(read(path))
            except ValueError as e:
                ctx.say("skip", path, f"not valid JSON ({e}); hooks not touched, fix the file and rerun")
                return
        if not isinstance(data, dict):
            ctx.say("skip", path, "unexpected content; hooks not touched")
            return
        before = json.dumps(data, sort_keys=True)
        hooks = data.get("hooks")
        if hooks is not None and not isinstance(hooks, dict):
            ctx.say("skip", path, "'hooks' is not an object; hooks not touched")
            return

        def is_ours(entry) -> bool:
            return isinstance(entry, dict) and any(
                HOOK_MARK in str(h.get("command", "")) for h in entry.get("hooks", []) if isinstance(h, dict))

        def is_foreign_caveman(entry) -> bool:
            return isinstance(entry, dict) and not is_ours(entry) and any(
                "caveman" in str(h.get("command", "")) for h in entry.get("hooks", []) if isinstance(h, dict))

        def is_our_statusline(sl) -> bool:
            return isinstance(sl, dict) and "upstream/src/hooks/caveman-statusline.sh" in str(sl.get("command", ""))

        plugin_on = any(k.startswith("caveman@") and v for k, v in (data.get("enabledPlugins") or {}).items()) \
            if isinstance(data.get("enabledPlugins"), dict) else False

        if remove:
            for event in ("SessionStart", "UserPromptSubmit"):
                lst = (hooks or {}).get(event)
                if isinstance(lst, list):
                    lst[:] = [e for e in lst if not is_ours(e)]
                    if not lst:
                        del hooks[event]
            if isinstance(hooks, dict) and not hooks:
                del data["hooks"]
            if is_our_statusline(data.get("statusLine")):
                del data["statusLine"]
        elif plugin_on:
            ctx.say("note", path, "caveman plugin is enabled and brings its own hooks; hooks and statusLine not added")
        else:
            hooks = data.setdefault("hooks", {})
            for event, arg, msg in (("SessionStart", "activate", "Loading caveman mode..."),
                                    ("UserPromptSubmit", "track", "Tracking caveman mode...")):
                lst = hooks.setdefault(event, [])
                if not isinstance(lst, list):
                    ctx.say("skip", path, f"hooks.{event} is not a list; not touched")
                    continue
                if any(is_foreign_caveman(e) for e in lst):
                    ctx.say("note", path, f"a caveman {event} hook exists already; kept, ours not added")
                    continue
                entry = {"hooks": [{"type": "command", "command": self.hook_command(arg),
                                    "timeout": 60, "statusMessage": msg}]}
                for i, e in enumerate(lst):
                    if is_ours(e):
                        lst[i] = entry
                        break
                else:
                    lst.append(entry)
            for event in [e for e, v in hooks.items() if v == []]:
                del hooks[event]
            if not hooks:
                del data["hooks"]
            sl = data.get("statusLine")
            if sl is None:
                data["statusLine"] = {"type": "command", "command": self.statusline_command()}
            elif is_our_statusline(sl):
                sl["command"] = self.statusline_command()
            else:
                ctx.say("note", path, "existing statusLine kept; the [CAVEMAN] badge is not added")
        if json.dumps(data, sort_keys=True) == before:
            ctx.say("unchanged", path)
            return
        existed = path.exists()
        if existed:
            ctx.backup(path)
        ctx.write(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        ctx.say("update" if existed else "create", path,
                "hooks removed" if remove else "SessionStart + UserPromptSubmit hooks")


