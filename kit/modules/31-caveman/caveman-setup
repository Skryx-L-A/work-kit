class Aider(Harness):
    name = "aider"
    binaries = ["aider"]

    def config_dirs(self):
        return [self.home / ".aider"]

    def rules(self) -> Path:
        return self.ctx.data_dir / "generated/caveman-aider.md"

    def conf(self) -> Path:
        return self.home / ".aider.conf.yml"

    def install(self):
        write_managed_file(self.ctx, self.rules(), rule_text())
        conf = self.conf()
        old = read(conf) if conf.exists() else ""
        base = LEGACY_AIDER_RE.sub("", old)  # kit < 2026-09-25 wrote a separate read: key with its own mark line
        new = read_list_put(base, str(self.rules()), AIDER_MARK)
        if new is None:
            self.ctx.say("note", conf, f"read: is an inline list; add {self.rules()} to it by hand")
        elif new == old:
            self.ctx.say("unchanged", conf)
        else:
            if conf.exists():
                self.ctx.backup(conf)
            self.ctx.write(conf, new)
            self.ctx.say("update" if old else "create", conf)

    def uninstall(self):
        conf = self.conf()
        if conf.exists() and AIDER_MARK in read(conf):
            old = read(conf)
            new = read_list_drop(LEGACY_AIDER_RE.sub("", old), AIDER_MARK)
            if new != old:
                if new.strip():
                    self.ctx.backup(conf)
                    self.ctx.write(conf, new)
                    self.ctx.say("remove", conf, "caveman lines removed")
                else:
                    self.ctx.say("remove", conf)
                    if not self.ctx.dry_run:
                        conf.unlink()
        remove_managed_file(self.ctx, self.rules())


class Continue(Harness):
    name = "continue"
    binaries: list[str] = []

    def config_dirs(self):
        return [self.home / ".continue"]

    def target(self) -> Path:
        return self.home / ".continue/rules/caveman.md"

    def install(self):
