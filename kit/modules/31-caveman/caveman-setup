HARNESSES = [Claude, Codex, Gemini, OpenCode, Copilot, Cursor, Aider, Continue]
BY_NAME = {h.name: h for h in HARNESSES}


# --- project level ----------------------------------------------------------------------

def project(ctx: Ctx, proj: Path, remove: bool) -> None:
    if not proj.is_dir():
        sys.exit(f"caveman-setup: not a directory: {proj}")
    blocks = [proj / "AGENTS.md", proj / ".github/copilot-instructions.md"]
    cursor = proj / ".cursor/rules/caveman.mdc"
    if remove:
        for b in blocks:
            strip_block(ctx, b)
        remove_managed_file(ctx, cursor)
        return
    for b in blocks:
        write_block(ctx, b, rule_text())
    fm = "---\ndescription: Chat style (caveman)\nalwaysApply: true\n---\n"
    write_managed_file(ctx, cursor, rule_text(), fm)
    ctx.say("note", proj, "Claude Code reads AGENTS.md itself from v2.1.277; older versions need a CLAUDE.md that imports it")


# --- main -------------------------------------------------------------------------------

def parse(argv):
    p = argparse.ArgumentParser(prog="caveman-setup", description=__doc__.split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    for name in ("install", "uninstall"):
        s = sub.add_parser(name)
        s.add_argument("--dry-run", "-n", action="store_true", help="show changes, write nothing")
        s.add_argument("--project", metavar="DIR", help="write/remove project-level files in DIR")
        if name == "install":
            s.add_argument("--harness", metavar="LIST",
                           help="comma-separated: " + ",".join(BY_NAME) + " (default: detected)")
            s.add_argument("--all", action="store_true", help="every harness, detected or not")
    sub.add_parser("verify")
    return p.parse_args(argv)


def main(argv=None) -> int:
    a = parse(argv)
    verify_upstream()
    if a.cmd == "verify":
        print("caveman-setup: upstream copy matches SHA256SUMS")
        return 0
    home = Path.home()
    ctx = Ctx(home, a.dry_run)

    if a.project:
        project(ctx, Path(a.project), remove=a.cmd == "uninstall")
        return finish(ctx)

    if a.cmd == "uninstall":
        for cls in HARNESSES:
            cls(ctx).uninstall()
        for d in (home / ".agents/skills",):
            unlink_ours(ctx, d / "caveman")
        return finish(ctx)

    if a.harness:
        wanted = [n.strip() for n in a.harness.split(",") if n.strip()]
        bad = [n for n in wanted if n not in BY_NAME]
        if bad:
            sys.exit(f"caveman-setup: unknown harness: {', '.join(bad)}")
        chosen = [BY_NAME[n](ctx) for n in wanted]
    elif a.all:
        chosen = [cls(ctx) for cls in HARNESSES]
    else:
        chosen = [h for h in (cls(ctx) for cls in HARNESSES) if h.detected()]
        skipped = [cls.name for cls in HARNESSES if cls.name not in {h.name for h in chosen}]
        print("detected: " + (", ".join(h.name for h in chosen) or "none"))
        if skipped:
            print("not detected (use --harness NAME or --all): " + ", ".join(skipped))
    for h in chosen:
        h.install()
    if any(h.name in SKILL_HARNESSES for h in chosen):
        link(ctx, home / ".agents/skills/caveman", UPSTREAM / "skills/caveman")
    return finish(ctx)


def finish(ctx: Ctx) -> int:
    summary = ", ".join(f"{k}={v}" for k, v in sorted(ctx.counts.items())) or "nothing to do"
    print(f"caveman-setup: {'dry run, ' if ctx.dry_run else ''}{summary}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
