class Harness:
    name = ""
    binaries: list[str] = []

    def __init__(self, ctx: Ctx):
        self.ctx = ctx
        self.home = ctx.home

    def config_dirs(self) -> list[Path]:
        return []

    def detected(self) -> bool:
        return any(which(b, self.home) for b in self.binaries) or any(
            d.exists() for d in self.config_dirs())

    def skills_link_dir(self):
        """Directory that needs per-skill links to ~/.agents/skills, or None if the
        harness reads ~/.agents/skills natively."""
        return None

    def sync(self, rules: str, canonical: Path) -> None:
        raise NotImplementedError

    def settings(self, mode: str, force: bool) -> None:
        """Approval mode and co-author attribution."""

    def mcp(self, servers: dict) -> None:
        """Register servers {name: (command, args)}; drop kit entries of other kit servers."""

    def json_files(self) -> list[Path]:
        """JSON files whose kit-owned keys --uninstall removes."""
        return []

    def unsync(self) -> None:
        raise NotImplementedError

    def unsync_settings(self) -> None:
        for f in self.json_files():
            json_unsync(self.ctx, f)

    def mcp_entries(self, path: Path, container: tuple, servers: dict, shape) -> None:
        wanted = {}
        for name, _bin, _args in MCP_SERVERS:
            keys = container + (name,)
            wanted[keys] = shape(*servers[name]) if name in servers else REMOVE
        if not servers and not any(self.ctx.owned(path, k) is not MISSING for k in wanted):
            return
        json_settings(self.ctx, path, wanted)


