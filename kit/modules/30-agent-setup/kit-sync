# 31-caveman: chat style rule) and tag the line with a "# work-kit-<module> ..." comment.
READ_MARK_RE = re.compile(r"^[ \t]+-[ \t].*[ \t]#[ \t]*work-kit-[a-z0-9]+\b")
OLD_CAVEMAN_RE = re.compile(r"# work-kit-caveman: chat style\nread:\n  - ([^\n]*)\n?")  # 31-caveman < 2026-09-25
YAML_BEGIN = "# work-kit:begin - managed by kit-sync"
YAML_END = "# work-kit:end"
YAML_MANAGED = "# work-kit:managed - generated by kit-sync, do not edit"
TOML_TOP = ("# work-kit:begin settings - managed by kit-sync", "# work-kit:end settings")
TOML_MCP = ("# work-kit:begin mcp - managed by kit-sync", "# work-kit:end mcp")
