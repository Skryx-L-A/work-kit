class Ctx:
    def __init__(self, home: Path, source: Path, dry_run: bool, home_given: bool = False):
        self.home = home
        self.source = source
        self.dry_run = dry_run
        self.home_given = home_given
        self.stamp = time.strftime("%Y%m%d%H%M%S")
        self.counts: dict[str, int] = {}
        self.data_dir = Path(os.environ.get("KIT_DATA_DIR") or home / ".local/share/work-kit")
        self.conf_dir = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config") / "work-kit"
        self.bin_dir = Path(os.environ.get("KIT_BIN_DIR") or home / ".local/bin")
        self.module_dir = Path(__file__).resolve().parent
        self.state_file = self.data_dir / "state/kit-sync.json"
        self.state = self._load_state()
        self.state_dirty = False
        self.touched: set = set()  # files written or backed up in this run
        self.saved_modes: dict = {}  # mode of a file moved to the backup; its replacement gets it back


    def say(self, action: str, path, note: str = "") -> None:
        self.counts[action] = self.counts.get(action, 0) + 1
        prefix = "would " if self.dry_run and action in WRITE_ACTIONS else ""
        print(f"[{prefix}{action}] {path}" + (f"  ({note})" if note else ""))

    def backup(self, path: Path) -> None:
        """Move path aside once per run; a file this run already saved or wrote needs none."""
        if not (path.exists() or path.is_symlink()) or path in self.touched:
            return
        self.touched.add(path)
        dest = self.backup_dest(path)
        self.say("backup", path, f"-> {dest}")
        if not self.dry_run:
            dest.parent.mkdir(parents=True, exist_ok=True)
            if not path.is_symlink():
                self.saved_modes[path] = path.stat().st_mode & 0o777
            shutil.move(str(path), str(dest))

    def backup_dest(self, path: Path) -> Path:
        """Backups live below the kit's data dir, never next to the user's file."""
        path = Path(os.path.abspath(path))
        try:
            rel = path.relative_to(self.home)
        except ValueError:
            rel = Path("_root") / path.relative_to(path.anchor)
        return self.data_dir / "backups" / "30-agent-setup" / rel.parent / f"{rel.name}.bak-{self.stamp}"

    def write_text(self, path: Path, text: str) -> None:
        self.touched.add(path)
        if self.dry_run:
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        new = not path.exists()
        path.write_text(text, encoding="utf-8")  # rewrites in place: an existing file keeps its mode
        if new:
            path.chmod(self.saved_modes.get(path, 0o644))

    # Settings kit-sync set, so a later run may change them and --uninstall may remove them.
    # Key: JSON list [file, key, subkey, ...]; value: what kit-sync wrote.
    def _load_state(self) -> dict:
        try:
            data = json.loads(self.state_file.read_text(encoding="utf-8"))
            return data if isinstance(data.get("owned"), dict) else {"owned": {}}
        except (OSError, ValueError, AttributeError):
            return {"owned": {}}

    def owned(self, path: Path, keys: tuple):
        return self.state["owned"].get(json.dumps([str(path), *keys]), MISSING)

    def own(self, path: Path, keys: tuple, value) -> None:
        k = json.dumps([str(path), *keys])
        if self.state["owned"].get(k, MISSING) != value:
            self.state["owned"][k] = value
            self.state_dirty = True

    def disown(self, path: Path, keys: tuple) -> None:
        if self.state["owned"].pop(json.dumps([str(path), *keys]), MISSING) is not MISSING:
            self.state_dirty = True

    def owned_keys(self, path: Path) -> list:
        out = []
        for k in self.state["owned"]:
            parts = json.loads(k)
            if parts[0] == str(path):
                out.append(tuple(parts[1:]))
        return out

    def save_state(self) -> None:
        if self.dry_run or not self.state_dirty:
            return
        self.state_file.parent.mkdir(parents=True, exist_ok=True)
        self.state_file.write_text(json.dumps(self.state, indent=2, sort_keys=True) + "\n",
                                   encoding="utf-8")


WRITE_ACTIONS = {"create", "update", "append", "link", "remove", "backup"}


def read(path: Path) -> str:
    return path.read_text(encoding="utf-8")


def block_of(content: str) -> str:
    return f"{BLOCK_BEGIN}\n{content.strip()}\n{BLOCK_END}\n"


def tilde(ctx: Ctx, path: Path) -> str:
    """Path as ~/... when it lies under home (the harness expands ~ to the same home)."""
    try:
        return "~/" + str(path.relative_to(ctx.home))
    except ValueError:
        return str(path)


# --- primitive operations -------------------------------------------------------------

def write_block(ctx: Ctx, path: Path, content: str) -> None:
    """Put content into a managed block of path, keeping any other text in the file."""
    block = block_of(content)
    if not path.exists():
        ctx.write_text(path, block)
        ctx.say("create", path)
        return
    old = read(path)
    if BLOCK_RE.search(old):
        new = BLOCK_RE.sub(lambda _m: block, old, count=1)
        if new == old:
            ctx.say("unchanged", path)
            return
        ctx.backup(path)
        ctx.write_text(path, new)
        ctx.say("update", path)
        return
    ctx.backup(path)
    prefix = old.rstrip("\n") + "\n\n" if old.strip() else ""
    ctx.write_text(path, prefix + block)
    ctx.say("append", path, "managed block added below your text")


def write_managed_file(ctx: Ctx, path: Path, body: str, frontmatter: str = "",
                       marker: str = MANAGED) -> None:
    """Write a file that kit-sync owns entirely (marker line after optional frontmatter)."""
    text = frontmatter + marker + "\n" + body.strip() + "\n"
    if path.exists():
        if read(path) == text:
            ctx.say("unchanged", path)
            return
        ctx.backup(path)
        ctx.write_text(path, text)
        ctx.say("update", path)
        return
    ctx.write_text(path, text)
    ctx.say("create", path)


def create_if_missing(ctx: Ctx, path: Path, text: str, marker: str = "") -> None:
    """Project files: create when absent, refresh when kit-managed, else leave alone."""
    if not path.exists():
        ctx.write_text(path, text)
        ctx.say("create", path)
        return
    old = read(path)
    if marker and marker in old:
        if old == text:
            ctx.say("unchanged", path)
        else:
            ctx.backup(path)
            ctx.write_text(path, text)
            ctx.say("update", path)
        return
    ctx.say("skip", path, "exists and is not managed by kit-sync; left untouched")


def link(ctx: Ctx, dst: Path, target: Path) -> None:
    if dst.is_symlink() and Path(os.readlink(dst)) == target:
        ctx.say("unchanged", dst)
        return
    if dst.exists() or dst.is_symlink():
        ctx.backup(dst)
    if not ctx.dry_run:
        dst.parent.mkdir(parents=True, exist_ok=True)
        dst.symlink_to(target)
    ctx.say("link", dst, f"-> {target}")


def strip_block(ctx: Ctx, path: Path) -> None:
    if not path.exists():
        return
    old = read(path)
    if not BLOCK_RE.search(old):
        return
    new = BLOCK_RE.sub("", old).rstrip("\n")
    if new.strip():
        ctx.backup(path)
        ctx.write_text(path, new + "\n")
        ctx.say("remove", path, "managed block removed")
    else:
        ctx.say("remove", path, "file held only the managed block")
        if not ctx.dry_run:
            path.unlink()


def remove_managed_file(ctx: Ctx, path: Path, marker: str = MANAGED) -> None:
    if path.exists() and marker in read(path):
        ctx.say("remove", path)
        if not ctx.dry_run:
            path.unlink()


# --- JSON settings --------------------------------------------------------------------

def load_json_obj(ctx: Ctx, path: Path):
    """dict of a JSON file ({} when missing), or None when it is not plain JSON."""
    if not path.exists():
        return {}
    text = read(path)
    if not text.strip():
        return {}
    try:
        data = json.loads(text)
    except ValueError as e:
        ctx.say("skip", path, f"not plain JSON ({e.__class__.__name__}: comments or a typo?); "
                "set the kit values by hand, see docs/adapters.md")
        return None
    if not isinstance(data, dict):
        ctx.say("skip", path, "not a JSON object; left untouched")
        return None
    return data


def get_in(d: dict, keys: tuple):
    for k in keys:
        if not isinstance(d, dict) or k not in d:
            return MISSING
        d = d[k]
    return d


def set_in(d: dict, keys: tuple, value) -> bool:
    for k in keys[:-1]:
        nxt = d.get(k)
        if nxt is None:
            nxt = d[k] = {}
        if not isinstance(nxt, dict):
            return False
        d = nxt
    d[keys[-1]] = value
    return True


def del_in(d: dict, keys: tuple) -> None:
    """Delete keys and drop parent objects that became empty."""
    trail = []
    for k in keys[:-1]:
        if not isinstance(d.get(k), dict):
            return
        trail.append((d, k))
        d = d[k]
    d.pop(keys[-1], None)
    for parent, k in reversed(trail):
        if parent[k] == {}:
            del parent[k]
        else:
            break


def json_settings(ctx: Ctx, path: Path, wanted: dict, force: set = frozenset()) -> set:
    """Apply {keypath: value | REMOVE} to a JSON file. A key is written when it is missing,
    already has the value, was written by kit-sync before (and not changed since), or is in
    `force`. A value you set yourself is kept. Returns the keypaths that hold the kit value."""
    data = load_json_obj(ctx, path)
    if data is None:
        return set()
    before = json.dumps(data, sort_keys=True)
    applied = set()
    for keys, value in wanted.items():
        cur = get_in(data, keys)
        owned = ctx.owned(path, keys)
        if value is REMOVE:
            if owned is not MISSING and cur == owned:
                del_in(data, keys)
            ctx.disown(path, keys)
            continue
        mine = owned is not MISSING and cur == owned
        if cur == value:
            applied.add(keys)
            if mine:
                ctx.own(path, keys, value)
        elif cur is MISSING or mine or keys in force:
            if set_in(data, keys, value):
                ctx.own(path, keys, value)
                applied.add(keys)
            else:
                ctx.say("skip", path, f"{'.'.join(keys[:-1])} is not an object; {keys[-1]} not set")
        else:
            ctx.disown(path, keys)
            ctx.say("keep", path, f"{'.'.join(keys)} = {json.dumps(cur)} is your value; "
                    f"kit value {json.dumps(value)} not applied")
    if json.dumps(data, sort_keys=True) == before:
        if path.exists():
            ctx.say("unchanged", path)
        return applied
    existed = path.exists()
    if existed:
        ctx.backup(path)
    if data:
        ctx.write_text(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        ctx.say("update" if existed else "create", path)
    else:
        ctx.say("remove", path, "held only kit settings")
        if not ctx.dry_run and path.exists():
            path.unlink()  # usually moved to the backup already
    return applied


def json_unsync(ctx: Ctx, path: Path) -> None:
    keys = ctx.owned_keys(path)
    if keys:
        json_settings(ctx, path, {k: REMOVE for k in keys})


# --- TOML (Codex) and YAML (Aider) regions ----------------------------------------------

def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{k} = {toml_value(x)}" for k, x in v.items()) + " }"
    return json.dumps(v)  # a JSON string is a valid TOML basic string


def region_re(begin: str, end: str):
    return re.compile(re.escape(begin) + r".*?" + re.escape(end) + r"[^\n]*\n?", re.S)


def toml_settings(ctx: Ctx, path: Path, top: dict, tables: dict) -> None:
    """Keep kit top-level keys in a region at the start of a TOML file and kit tables in a
    region at its end. Keys and tables the file defines outside the regions win."""
    old = read(path) if path.exists() else ""
    user = region_re(*TOML_MCP).sub("", region_re(*TOML_TOP).sub("", old)).strip("\n")
    head = re.split(r"(?m)^\s*\[", user, maxsplit=1)[0]
    user_keys = set(re.findall(r"(?m)^\s*([A-Za-z0-9_-]+)\s*=", head))
    # an inline table of the kit would clash with a table or dotted key of the same name
    user_keys |= set(re.findall(r"(?m)^\s*([A-Za-z0-9_-]+)\s*\.", head))
    user_keys |= set(re.findall(r"(?m)^\s*\[\s*([A-Za-z0-9_-]+)\s*[\].]", user))
    lines = []
    for k, v in top.items():
        if k in user_keys:
            ctx.say("keep", path, f"{k} is set by you; kit value {toml_value(v)} not applied")
        else:
            lines.append(f"{k} = {toml_value(v)}")
    tbl = []
    for name, spec in tables.items():
        table = name.split(".", 1)
        if re.search(r'(?m)^\s*\[\s*' + re.escape(table[0]) + r'\.(?:"' + re.escape(table[1])
                     + r'"|' + re.escape(table[1]) + r')\s*[\].]', user):
            ctx.say("keep", path, f"[{name}] is defined by you; kit entry not added")
            continue
        tbl.append(f"[{table[0]}.{json.dumps(table[1]) if not re.fullmatch(r'[A-Za-z0-9_-]+', table[1]) else table[1]}]")
        tbl += [f"{k} = {toml_value(v)}" for k, v in spec.items()]
    parts = []
    if lines:
        parts.append("\n".join([TOML_TOP[0], *lines, TOML_TOP[1]]) + "\n")
    if user:
        parts.append(user + "\n")
    if tbl:
        parts.append("\n".join([TOML_MCP[0], *tbl, TOML_MCP[1]]) + "\n")
    new = "\n".join(parts)
    replace_text(ctx, path, old, new, check_toml=True)


def replace_text(ctx: Ctx, path: Path, old: str, new: str, check_toml: bool = False) -> None:
    if new == old:
        if path.exists():
            ctx.say("unchanged", path)
        return
    if check_toml:
        try:
            import tomllib  # Python 3.11+; older Pythons skip the check
        except ImportError:
            tomllib = None
        if tomllib is not None:
            try:
                tomllib.loads(new)
            except tomllib.TOMLDecodeError as e:
                ctx.say("skip", path, f"result would not be valid TOML ({e}); left untouched")
                return
    existed = path.exists()
    if existed:
        ctx.backup(path)
    if new.strip():
        ctx.write_text(path, new)
        ctx.say("update" if existed else "create", path)
    else:
        ctx.say("remove", path, "held only kit settings")
        if not ctx.dry_run and path.exists():
            path.unlink()  # usually moved to the backup already


def yaml_scalar(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    return json.dumps(v)  # a JSON string is a valid YAML double-quoted scalar


def split_read_marks(text: str):
    """(text without the marked lines of its top-level read: list, those lines). A read: key left
    without items goes too, so the kit region can own it."""
    lines, marked = text.split("\n"), []
    out, in_read = [], False
    for ln in lines:
        if re.match(r"^read:[ \t]*$", ln):
            in_read = True
            out.append(ln)
            continue
        if in_read and READ_MARK_RE.match(ln):
            marked.append(ln)
            continue
        if in_read and not re.match(r"^[ \t]*-", ln):
            in_read = False
        out.append(ln)
    if not marked:
        return text, []
    for i, ln in enumerate(out):
        if re.match(r"^read:[ \t]*$", ln) and not (i + 1 < len(out) and re.match(r"^[ \t]*-", out[i + 1])):
            del out[i]
            break
    return "\n".join(out), marked


def add_read_lines(text: str, lines: list):
    """Append the lines to the top-level read: list of text (block list, single value or empty)."""
    m = re.search(r"(?m)^read:[ \t]*(.*)$", text)
    if m is None:
        return text.rstrip("\n") + ("\n" if text.strip() else "") + "read:\n" + "\n".join(lines) + "\n"
    value = m.group(1).strip()
    if value == "" or value == "[]":
        end = m.end()
        if value == "":
            for item in re.finditer(r"\n([ \t]*-[^\n]*)", text[m.end():]):
                if item.start() != end - m.end():
                    break
                end = m.end() + item.end()
        head = text[:m.start()] + "read:" + text[m.end():end] if value == "" else text[:m.start()] + "read:"
        return head + "\n" + "\n".join(lines) + text[end:]
    if value.startswith("["):
        return None  # inline list: left to you
    return text[:m.start()] + "read:\n  - %s\n%s" % (value, "\n".join(lines)) + text[m.end():]


def aider_settings(ctx: Ctx, path: Path, wanted: dict) -> None:
    """Keep kit keys of ~/.aider.conf.yml in one region at the end; keys you set outside the
    region win. A 'read' value is a list of paths. Lines other kit modules added to the read: list
    (marked "# work-kit-<module>") are carried over into the region, or into your own read: list."""
    old = read(path) if path.exists() else ""
    region = region_re(YAML_BEGIN, YAML_END).search(old)
    carried = [ln for ln in region.group(0).splitlines() if READ_MARK_RE.match(ln)] if region else []
    user = region_re(YAML_BEGIN, YAML_END).sub("", old)
    user = re.sub(re.escape(OLD_AIDER_MARK) + r"\nread:\n  - [^\n]*\n?", "", user)  # kit < 2026-09-25
    for m in OLD_CAVEMAN_RE.finditer(user):
        carried.append("  - %s  # work-kit-caveman: chat style" % m.group(1))
    user = OLD_CAVEMAN_RE.sub("", user)
    user, moved = split_read_marks(user)
    carried += [ln for ln in moved if ln not in carried]
    user = user.strip("\n")
    user_keys = set(re.findall(r"(?m)^([A-Za-z0-9_-]+)\s*:", user))
    lines = []
    for k, v in wanted.items():
        if k in user_keys:
            hint = f"add {v[0]} to it by hand" if k == "read" else f"kit value {yaml_scalar(v)} not applied"
            ctx.say("note", path, f"has a '{k}:' key already; {hint}")
            continue
        if isinstance(v, list):
            lines.append(f"{k}:")
            lines += [f"  - {yaml_scalar(x)}" for x in v]
            if k == "read":
                lines += carried
                carried = []
        else:
            lines.append(f"{k}: {yaml_scalar(v)}")
    if carried:  # no kit read: list to hold them (your own read: list, or a sync without one)
        user = (add_read_lines(user, carried) or user).strip("\n") if user else "read:\n" + "\n".join(carried)
    parts = [user + "\n"] if user else []
    if lines:
        parts.append("\n".join([YAML_BEGIN, *lines, YAML_END]) + "\n")
    replace_text(ctx, path, old, "\n".join(parts))


