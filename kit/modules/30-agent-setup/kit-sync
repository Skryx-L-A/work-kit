def which(binary: str, home: Path):
    dirs = os.environ.get("PATH", "").split(os.pathsep) + [str(home / ".local/bin")]
    for d in dirs:
        p = Path(d) / binary
        if p.is_file() and os.access(p, os.X_OK):
            return p
    return None


# --- MCP servers ----------------------------------------------------------------------

def allowlisted(ctx: Ctx):
    """Server names on 13-ai-governance's allowlist, or None when there is no allowlist."""
    f = ctx.conf_dir / "mcp-allowlist.yaml"
    if not f.is_file():
        return None
    return set(re.findall(r"(?m)^\s*-?\s*name:\s*[\"']?([A-Za-z0-9_.-]+)", read(f)))


def kit_mcp_servers(ctx: Ctx) -> dict:
    allow = allowlisted(ctx)
    out = {}
    for name, binary, args in MCP_SERVERS:
        p = ctx.bin_dir / binary
        if not (p.is_file() and os.access(p, os.X_OK)):
            p = which(binary, ctx.home)
        if not p:
            continue
        if allow is not None and name not in allow:
            ctx.say("note", "mcp", f"{name} is installed but not on {ctx.conf_dir / 'mcp-allowlist.yaml'}; "
                    "not registered (default deny)")
            continue
        out[name] = (str(p), list(args))
    return out


# --- global git hooks -----------------------------------------------------------------

def git_env(ctx: Ctx) -> dict:
    env = dict(os.environ, HOME=str(ctx.home))
    if ctx.home_given:
        env.pop("GIT_CONFIG_GLOBAL", None)
    return env


def git_global(ctx: Ctx, *args: str):
    try:
        return subprocess.run(["git", "config", "--global", *args], capture_output=True,
                              text=True, env=git_env(ctx))
    except OSError:
        return None


def hooks_dir(ctx: Ctx) -> Path:
    return ctx.conf_dir / "git-hooks"


def sync_git_hooks(ctx: Ctx) -> None:
    """Install the dispatcher under every hook name and point core.hooksPath at it, unless
    core.hooksPath already points somewhere else."""
    src = ctx.module_dir / "git-hooks/dispatch"
    if not shutil.which("git", path=os.environ.get("PATH")):
        ctx.say("note", "git-hooks", "git not found; co-author stripping hook not installed")
        return
    if not src.is_file():
        ctx.say("note", "git-hooks", f"{src} missing; hook not installed")
        return
    d = hooks_dir(ctx)
    r = git_global(ctx, "--get", "core.hooksPath")
    cur = r.stdout.strip() if r else ""
    if cur and Path(os.path.expanduser(cur.replace("~", str(ctx.home), 1) if cur.startswith("~") else cur)) != d:
        ctx.say("note", "git-hooks", f"core.hooksPath is '{cur}' (not the kit's); left as is, "
                "so Co-authored-by lines are not stripped. Remove it and rerun kit-sync to use the kit hooks")
        return
    text = read(src)
    counts = {"create": 0, "update": 0, "unchanged": 0}
    dg_found = (d / DG_FLAG).exists()
    for name in HOOK_NAMES:
        f = d / name
        if f.exists():
            old = read(f)
            if old == text and os.access(f, os.X_OK):
                counts["unchanged"] += 1
                continue
            if DG_MARK in old:
                dg_found = True  # data-guard's global stub: the dispatcher runs data-guard now
            elif DISPATCH_MARK not in old:
                ctx.backup(f)  # a hook of yours in the kit hooks dir
            counts["update"] += 1
        else:
            counts["create"] += 1
        if not ctx.dry_run:
            d.mkdir(parents=True, exist_ok=True)
            f.write_text(text, encoding="utf-8")
            f.chmod(0o755)
    for f in sorted(d.iterdir()) if d.is_dir() else []:
        if f.name not in HOOK_NAMES and f.is_file() and DISPATCH_MARK in read(f):
            ctx.say("remove", f, "hook name no longer dispatched")
            if not ctx.dry_run:
                f.unlink()
    for action in ("create", "update"):
        if counts[action]:
            ctx.say(action, d, f"{counts[action]} hook dispatchers")
    if counts["unchanged"] == len(HOOK_NAMES):
        ctx.say("unchanged", d, "hook dispatchers")
    if dg_found and not (d / DG_FLAG).exists():
        ctx.say("create", d / DG_FLAG, "data-guard was enabled globally; the dispatcher keeps running it")
        if not ctx.dry_run:
            (d / DG_FLAG).write_text("data-guard global pre-commit is on (set by kit-sync)\n")
    if not cur:
        ctx.say("update", "git config --global core.hooksPath", str(d))
        if not ctx.dry_run:
            git_global(ctx, "core.hooksPath", str(d))


def unsync_git_hooks(ctx: Ctx) -> None:
    d = hooks_dir(ctx)
    if not d.is_dir():
        return
    removed = 0
    for f in sorted(d.iterdir()):
        if f.is_file() and not f.name.startswith(".") and DISPATCH_MARK in read(f):
            removed += 1
            if not ctx.dry_run:
                f.unlink()
    if removed:
        ctx.say("remove", d, f"{removed} hook dispatchers")
    stub = ctx.data_dir / "data-guard/hook-stub.sh"
    if (d / DG_FLAG).exists():
        if stub.is_file():
            ctx.say("create", d, "data-guard global hooks restored")
            if not ctx.dry_run:
                for name in DG_HOOK_NAMES:
                    shutil.copyfile(stub, d / name)
                    (d / name).chmod(0o755)
        ctx.say("remove", d / DG_FLAG)
        if not ctx.dry_run:
            (d / DG_FLAG).unlink()
        if stub.is_file():
            return
    left = [p for p in d.iterdir() if p.name in HOOK_NAMES] if d.is_dir() and not ctx.dry_run else []
    r = git_global(ctx, "--get", "core.hooksPath")
    if r and r.stdout.strip() == str(d) and not left:
        ctx.say("remove", "git config --global core.hooksPath")
        if not ctx.dry_run:
            git_global(ctx, "--unset", "core.hooksPath")


# --- kit.conf -------------------------------------------------------------------------

def conf_file(ctx: Ctx) -> Path:
    return ctx.conf_dir / "kit.conf"


def conf_get(ctx: Ctx, key: str):
    f = conf_file(ctx)
    if not f.is_file():
        return None
    for line in read(f).splitlines():
        m = re.match(r"\s*([A-Za-z0-9_.-]+)\s*=\s*(.*?)\s*$", line)
        if m and m.group(1) == key:
            return m.group(2)
    return None


def conf_set(ctx: Ctx, key: str, value: str) -> None:
    f = conf_file(ctx)
    old = read(f) if f.is_file() else "# work-kit settings (key=value)\n"
    line = f"{key}={value}"
    pat = re.compile(r"(?m)^\s*" + re.escape(key) + r"\s*=.*$")
    new = pat.sub(line, old, count=1) if pat.search(old) else old.rstrip("\n") + "\n" + line + "\n"
    if new != old:
        ctx.write_text(f, new)
        ctx.say("update" if f.is_file() else "create", f, line)


# --- skills ---------------------------------------------------------------------------

def skill_dirs(source: Path) -> list[Path]:
    root = source / "skills"
    if not root.is_dir():
        return []
    return sorted(p for p in root.iterdir() if (p / "SKILL.md").is_file())


def prune_links(ctx: Ctx, directory: Path, keep: set, under: Path) -> None:
    """Remove links that point into `under` but whose skill no longer exists."""
    if not directory.is_dir():
        return
    for entry in sorted(directory.iterdir()):
        if entry.is_symlink() and entry.name not in keep:
            target = Path(os.readlink(entry))
            if str(target).startswith(str(under)):
                ctx.say("remove", entry, "stale skill link")
                if not ctx.dry_run:
                    entry.unlink()


def sync_skills(ctx: Ctx, harnesses: list[Harness]) -> None:
    skills = skill_dirs(ctx.source)
    canonical = ctx.home / ".agents/skills"
    if not skills:
        ctx.say("note", "skills", f"no skills found in {ctx.source / 'skills'}")
    for s in skills:
        link(ctx, canonical / s.name, s.resolve())
    names = {s.name for s in skills}
    root = (ctx.source / "skills").resolve()
    prune_links(ctx, canonical, names, root)
    for h in harnesses:
        d = h.skills_link_dir()
        if d is None:
            continue
        for s in skills:
            link(ctx, d / s.name, canonical / s.name)
        prune_links(ctx, d, names, canonical)


def unsync_skills(ctx: Ctx) -> None:
    root = (ctx.source / "skills").resolve()
    canonical = ctx.home / ".agents/skills"
    for d in [canonical] + [h(ctx).skills_link_dir() for h in HARNESSES
                            if h(ctx).skills_link_dir()]:
        under = root if d == canonical else canonical
        prune_links(ctx, d, set(), under)


# --- project mode ---------------------------------------------------------------------

PROJECT_DEFAULT = ["claude", "copilot", "cursor"]
PROJECT_ALL = ["claude", "gemini", "copilot", "cursor", "aider", "continue"]


def sync_project(ctx: Ctx, project: Path, names: list[str], force: bool) -> None:
    if not project.is_dir():
        sys.exit(f"kit-sync: not a directory: {project}")
    tpl = ctx.source / "project-AGENTS.md"
    template = read(tpl) if tpl.is_file() else PROJECT_TEMPLATE
    agents = project / "AGENTS.md"
    if force and agents.exists():
        ctx.backup(agents)
    if not agents.exists() or force:
        ctx.write_text(agents, template)
        ctx.say("create", agents)
        text = template
    else:
        ctx.say("unchanged", agents, "kept as is; it is the source for the adapter files")
        text = read(agents)
    body = re.sub(r"\A# AGENTS\.md\n+", "", text).strip()
    mk = MANAGED
    pointer = "@AGENTS.md\n"
    for n in names:
        if n == "claude":
            create_if_missing(ctx, project / "CLAUDE.md", pointer + "\n" + mk + "\n", mk)
        elif n == "gemini":
            create_if_missing(ctx, project / "GEMINI.md", pointer + "\n" + mk + "\n", mk)
        elif n == "copilot":
            create_if_missing(ctx, project / ".github/copilot-instructions.md",
                              mk + "\n" + body + "\n", mk)
        elif n == "cursor":
            fm = ("---\ndescription: Repository instructions\nalwaysApply: true\n---\n")
            create_if_missing(ctx, project / ".cursor/rules/work-kit.mdc",
                              fm + mk + "\nFollow the instructions in @AGENTS.md\n", mk)
        elif n == "aider":
            create_if_missing(ctx, project / ".aider.conf.yml",
                              "# work-kit: managed\nread:\n  - AGENTS.md\n", "# work-kit: managed")
        elif n == "continue":
            fm = "---\nname: Repository instructions\nalwaysApply: true\n---\n"
            create_if_missing(ctx, project / ".continue/rules/work-kit.md",
                              fm + mk + "\n" + body + "\n", mk)
        else:
            sys.exit(f"kit-sync: unknown harness for --project: {n}")


# --- main -----------------------------------------------------------------------------

def default_source() -> Path:
    env = os.environ.get("KIT_SYNC_SOURCE")
    if env:
        return Path(env)
    return Path(__file__).resolve().parent / "source"


def parse(argv):
    p = argparse.ArgumentParser(prog="kit-sync", description=DOC.split("\n\n")[0],
                                epilog="Harness file locations: docs/adapters.md in the kit repository.")
    p.add_argument("--dry-run", "-n", action="store_true", help="show changes, write nothing")
    p.add_argument("--project", metavar="DIR", help="write project-level adapters into DIR")
    p.add_argument("--harness", metavar="LIST",
                   help="comma-separated: " + ",".join(BY_NAME) + " (default: detected)")
    p.add_argument("--all", action="store_true", help="every harness, detected or not")
    p.add_argument("--permissions", choices=PERMISSION_MODES,
                   help="bypass: no approval prompts (kit default); ask: the harness asks. "
                        "Saved in ~/.config/work-kit/kit.conf")
    p.add_argument("--no-skills", action="store_true", help="do not link skills")
    p.add_argument("--no-settings", action="store_true",
                   help="do not touch approval mode, attribution or MCP registrations")
    p.add_argument("--no-git-hooks", action="store_true", help="do not install the global git hooks")
    p.add_argument("--uninstall", action="store_true", help="remove what kit-sync created")
    p.add_argument("--force", action="store_true",
                   help="--project: replace an existing AGENTS.md (backup is made)")
    p.add_argument("--list", action="store_true", help="show harnesses and detection, then exit")
    p.add_argument("--source", metavar="DIR", help="source dir (default: next to this script)")
    p.add_argument("--home", metavar="DIR", help="use DIR as home (for tests)")
    return p.parse_args(argv)


def main(argv=None) -> int:
    a = parse(argv)
    home = Path(a.home) if a.home else Path.home()
    source = Path(a.source) if a.source else default_source()
    ctx = Ctx(home, source, a.dry_run, home_given=bool(a.home))

    if a.list:
        for cls in HARNESSES:
            h = cls(ctx)
            print(f"{h.name:9} {'detected' if h.detected() else 'not found'}")
        print(f"permissions: {conf_get(ctx, 'permissions') or 'bypass'} ({conf_file(ctx)})")
        return 0

    if a.project:
        names = a.harness.split(",") if a.harness else (
            PROJECT_ALL if a.all else PROJECT_DEFAULT)
        agents_src = source / "AGENTS.md"
        if not agents_src.is_file() and not (source / "project-AGENTS.md").is_file():
            print(f"kit-sync: note: {source} has no AGENTS.md; using the built-in template")
        sync_project(ctx, Path(a.project), names, a.force)
        return finish(ctx)

    if a.harness:
        wanted = [n.strip() for n in a.harness.split(",") if n.strip()]
        bad = [n for n in wanted if n not in BY_NAME]
        if bad:
            sys.exit(f"kit-sync: unknown harness: {', '.join(bad)}")
        chosen = [BY_NAME[n](ctx) for n in wanted]
    elif a.all or a.uninstall:
        chosen = [cls(ctx) for cls in HARNESSES]
    else:
        chosen = [h for h in (cls(ctx) for cls in HARNESSES) if h.detected()]
        skipped = [cls.name for cls in HARNESSES if cls.name not in {h.name for h in chosen}]
        print("detected: " + (", ".join(h.name for h in chosen) or "none"))
        if skipped:
            print("not detected (use --harness NAME or --all): " + ", ".join(skipped))

    if a.uninstall:
        for h in chosen:
            h.unsync()
        unsync_skills(ctx)
        if not a.harness and not a.no_git_hooks:
            unsync_git_hooks(ctx)
        if not a.harness and not ctx.state["owned"] and ctx.state_file.exists() and not ctx.dry_run:
            ctx.state_file.unlink()
            ctx.state_dirty = False
        return finish(ctx)

    rules_file = source / "AGENTS.md"
    if not rules_file.is_file():
        sys.exit(f"kit-sync: missing {rules_file}")
    rules = read(rules_file)
    canonical = rules_file.resolve()

    mode = a.permissions or conf_get(ctx, "permissions") or "bypass"
    if mode not in PERMISSION_MODES:
        print(f"kit-sync: note: permissions={mode} in {conf_file(ctx)} is unknown; using bypass")
        mode = "bypass"
    if a.permissions:
        conf_set(ctx, "permissions", a.permissions)
    servers = {} if a.no_settings else kit_mcp_servers(ctx)

    for h in chosen:
        h.sync(rules, canonical)
        if not a.no_settings:
            h.settings(mode, force=bool(a.permissions))
            h.mcp(servers)
    if not a.no_skills:
        sync_skills(ctx, chosen)
    if not a.no_git_hooks:
        sync_git_hooks(ctx)
    return finish(ctx)


def finish(ctx: Ctx) -> int:
    ctx.save_state()
    summary = ", ".join(f"{k}={v}" for k, v in sorted(ctx.counts.items())) or "nothing to do"
    print(f"kit-sync: {'dry run, ' if ctx.dry_run else ''}{summary}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
