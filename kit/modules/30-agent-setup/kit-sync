BLOCK_BEGIN = ("<!-- work-kit:begin - managed by kit-sync, edit the kit source "
               "(source/AGENTS.md), not this block -->")
BLOCK_END = "<!-- work-kit:end -->"
MANAGED = "<!-- work-kit:managed - generated by kit-sync, do not edit -->"
BLOCK_RE = re.compile(r"<!-- work-kit:begin.*?-->.*?<!-- work-kit:end -->\n?", re.S)
OLD_AIDER_MARK = "# work-kit: shared agent rules"
