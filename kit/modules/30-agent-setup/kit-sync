#!/bin/sh
''':'
# Shell part (Python reads it as a string): find a Python 3 and run this file with it.
# Order: $KIT_PYTHON, python3 on PATH, the kit CPython of module 00-python.
for py in "${KIT_PYTHON:-}" "$(command -v python3 2>/dev/null)" \
    "${KIT_BIN_DIR:-$HOME/.local/bin}/python3.12" \
    "$("${KIT_BIN_DIR:-$HOME/.local/bin}/uv" python find 3.12 2>/dev/null)" \
    "${UV_PYTHON_INSTALL_DIR:-$HOME/.local/share/uv/python}"/cpython-3.12*/bin/python3 \
    "${KIT_DATA_DIR:-$HOME/.local/share/work-kit}"/bootstrap-python/python/bin/python3; do
  # Run-check, not just -x: a broken or stub python3 on PATH must not win.
  if [ -n "$py" ] && [ -x "$py" ] && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 8))' >/dev/null 2>&1; then
    exec "$py" "$0" "$@"
  fi
done
echo "kit-sync: no python3 found; install module 00-python (kit CPython) first" >&2
exit 1
'''
